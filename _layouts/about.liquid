---
layout: default
---
<div class="post">
  <article>
    <div class="about-copy">{{ content }}</div>
    {% if page.selected_research_highlights or page.selected_papers %}
      <section class="home-section" aria-labelledby="selected-work-title">
        <h2 id="selected-work-title">Selected work</h2>
        {% include selected_research_highlights.liquid %}
        <p class="section-more"><a href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">&rarr;</span></a></p>
      </section>
    {% endif %}
    {% if page.announcements and page.announcements.enabled %}
      <section class="home-section" aria-labelledby="news-title">
        <div class="section-heading"><h2 id="news-title">News</h2><a href="{{ '/news/' | relative_url }}">All news <span aria-hidden="true">&rarr;</span></a></div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section"><h2><a href="{{ '/blog/' | relative_url }}">Latest posts</a></h2>{% include latest_posts.liquid %}</section>
    {% endif %}
  </article>
</div>
