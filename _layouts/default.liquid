<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  {% assign page_slug = page.url | default: '/' | replace: '/', ' ' | strip | split: ' ' | first | default: 'home' %}
  <body class="page-{{ page_slug }} {% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <main id="main-content" class="container site-main">
      {% if page.toc and page.toc.sidebar and page_slug != 'cv' %}
        {% assign toc_col_class = 'col-sm-3' %}
        {% assign content_col_class = 'col-sm-9' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="{{ content_col_class }}">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="{{ toc_col_class }}">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="{{ toc_col_class }}">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="{{ content_col_class }}">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </main>

    {% if page.gallery_timeline %}
      <!-- This independent layout script runs before shared third-party scripts. -->
      <script src="{{ '/assets/js/gallery-timeline.js' | relative_url | bust_file_cache }}"></script>
    {% endif %}

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
