{% comment %}
  Unified skills entry renderer for both formats
{% endcomment %}

<div class="cv-skills">
  {% for entry in entries %}
    <div class="skill-item">
      <h4 class="cv-entry-label">{{ entry.name }}</h4>
      <ul class="skill-keywords">
        {% for keyword in entry.keywords %}
          <li>{{ keyword }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
</div>
