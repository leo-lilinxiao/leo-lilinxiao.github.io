<a class="skip-link" href="#main-content">Skip to content</a>
{% assign home_page = site.pages | where: 'permalink', '/' | first %}
<header class="site-header">
  <div class="folio-masthead">
    <div class="folio-identity">
      {% if page.permalink == '/' %}<h1 class="folio-name">{% else %}<p class="folio-name">{% endif %}
        <a href="{{ '/' | relative_url }}">{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}</a>
      {% if page.permalink == '/' %}</h1>{% else %}</p>{% endif %}
      <p class="folio-subtitle">AI Infrastructure &amp; LLM Systems</p>
      {% if site.enable_navbar_social %}
        <div class="folio-profiles" aria-label="Profile links">{% include profile_links.liquid labels=true %}</div>
      {% endif %}
    </div>
    <img class="folio-portrait" src="{{ home_page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Leo (Linxiao) Li" width="152" height="166" fetchpriority="high">
  </div>
  <nav id="navbar" class="folio-navigation" aria-label="Main navigation">
    <ul>
      <li><a href="{{ '/' | relative_url }}"{% if page.permalink == '/' %} aria-current="page"{% endif %}>About</a></li>
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null %}
          {% assign parent_link = p.permalink | remove: 'index.html' %}
          {% assign is_current_section = false %}
          {% if page.url contains parent_link or page.nav_parent == parent_link %}{% assign is_current_section = true %}{% endif %}
          <li><a href="{{ p.url | relative_url }}"{% if is_current_section %} aria-current="{% if page.url == p.url %}page{% else %}location{% endif %}"{% endif %}>{{ p.title }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
    {% if site.enable_darkmode %}
      <button id="light-toggle" type="button" title="Theme: System" aria-label="Theme: System">
        <span class="theme-toggle-icon" aria-hidden="true"><i class="fa-half-sun-moon" id="light-toggle-system"></i><span id="light-toggle-dark">{% include icons/moon.svg %}</span><span id="light-toggle-light">{% include icons/sun.svg %}</span></span>
        <span class="theme-toggle-label" aria-hidden="true"><span id="theme-label-system">Auto</span><span id="theme-label-dark">Dark</span><span id="theme-label-light">Light</span></span>
      </button>
    {% endif %}
  </nav>
</header>
