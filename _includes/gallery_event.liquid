{% assign event = include.event %}
{% assign external = false %}
{% if event.url %}
  {% if event.url contains '://' %}
    {% assign destination = event.url %}
    {% assign external = true %}
  {% else %}
    {% assign destination = event.url | relative_url %}
  {% endif %}
{% else %}
  {% assign destination = event.photos.first.path | relative_url %}
{% endif %}
<a
  class="gallery-card{% if event.url %} gallery-card-link{% endif %}{% if event.shape == 'wide' %} gallery-card-wide{% endif %}"
  href="{{ destination }}"
  {% if external %}target="_blank" rel="noopener noreferrer"{% elsif event.url == nil %}data-gallery-open aria-haspopup="dialog"{% endif %}
  aria-label="{{ event.title | escape }} — {{ event.action | escape }}{% if external %} (opens in a new tab){% endif %}"
>
  <picture class="gallery-cover{% if event.fit == 'contain' %} gallery-cover-contain{% endif %}{% if event.shape == 'wide' %} gallery-cover-wide{% endif %}">
    {% if site.imagemagick.enabled %}
      {% assign cover_base = event.cover | remove: '.jpg' | remove: '.png' %}
      <source type="image/webp" srcset="{% for width in site.imagemagick.widths %}{{ cover_base | relative_url }}-{{ width }}.webp {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}" sizes="(max-width: 767px) 124px, {% if event.shape == 'wide' %}248px{% else %}208px{% endif %}">
    {% endif %}
    <img src="{{ event.cover | relative_url }}" alt="{{ event.cover_alt | escape }}" loading="lazy" decoding="async" width="800" height="533"{% if event.position %} style="object-position: {{ event.position }}"{% endif %}>
  </picture>
  <div class="gallery-card-copy">
    <h3 class="gallery-event-title">{{ event.title }}</h3>
    {% if event.description %}<p class="gallery-event-description">{{ event.description }}</p>{% endif %}
    <span class="gallery-event-action"><i class="fa-solid {% if external %}fa-arrow-up-right-from-square{% elsif event.url %}fa-arrow-right{% else %}fa-expand{% endif %}" aria-hidden="true"></i> {{ event.action }}</span>
  </div>
</a>
{% if event.source_url %}
  <a class="gallery-source-link" href="{{ event.source_url }}" hreflang="zh" target="_blank" rel="noopener noreferrer">{{ event.source_label }} <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a>
{% endif %}
{% for photo in event.photos %}
  {% assign photo_base = photo.path | remove: '.jpg' | remove: '.png' %}
  <a hidden data-gallery-photo href="{{ photo.path | relative_url }}"
     data-display="{% if photo.display %}{{ photo.display | relative_url }}{% elsif site.imagemagick.enabled %}{{ photo_base | relative_url }}-1400.webp{% else %}{{ photo.path | relative_url }}{% endif %}"
     data-thumbnail="{% if photo.thumbnail %}{{ photo.thumbnail | relative_url }}{% elsif site.imagemagick.enabled %}{{ photo_base | relative_url }}-480.webp{% else %}{{ photo.path | relative_url }}{% endif %}"
     data-caption="{{ photo.caption | escape }}" tabindex="-1" aria-hidden="true">{{ photo.caption }}</a>
{% endfor %}
