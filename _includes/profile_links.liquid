{% assign profiles = site.data.socials %}
{% if profiles.email %}
  <a href="mailto:{{ profiles.email | encode_email }}" title="Email" aria-label="Email">{% include icons/envelope.svg %}{% if include.labels %}<span>Email</span>{% endif %}</a>
{% endif %}
{% if profiles.github_username %}
  <a href="https://github.com/{{ profiles.github_username | escape }}" title="GitHub" aria-label="GitHub">{% include icons/github.svg %}{% if include.labels %}<span>GitHub</span>{% endif %}</a>
{% endif %}
{% if profiles.scholar_userid %}
  <a href="https://scholar.google.com/citations?user={{ profiles.scholar_userid | escape }}" title="Google Scholar" aria-label="Google Scholar">{% include icons/google-scholar.svg %}{% if include.labels %}<span>Scholar</span>{% endif %}</a>
{% endif %}
{% if profiles.orcid_id %}
  <a href="https://orcid.org/{{ profiles.orcid_id | escape }}" title="ORCID" aria-label="ORCID"><i class="ai ai-orcid" aria-hidden="true"></i>{% if include.labels %}<span>ORCID</span>{% endif %}</a>
{% endif %}
{% if profiles.custom_social %}
  <a href="{{ profiles.custom_social.url | escape }}" title="{{ profiles.custom_social.title | escape }}" aria-label="{{ profiles.custom_social.title | escape }}"><i class="{{ profiles.custom_social.logo | escape }}" aria-hidden="true"></i>{% if include.labels %}<span>{{ profiles.custom_social.title | escape }}</span>{% endif %}</a>
{% endif %}
