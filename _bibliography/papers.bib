  bibtex_show = {true},
  abstract  = {Zeta is a dual whitening optimizer for matrix-aware neural network training. It combines coordinate whitening and spectral whitening to address coordinate-wise scale imbalance in momentum matrices, improving conditioning and orthogonalization reliability across language modeling, MoE, and vision workloads.},
  arxiv     = {2606.14187},
  pdf       = {https://arxiv.org/pdf/2606.14187v2},
  code      = {https://github.com/AIGCodeOS/aigcode_zeta_optimizer},
  url       = {https://arxiv.org/abs/2606.14187v2},
}

